# based on sample gitignore from https://betterstack.com/community/questions/gitignore-template-for-android-studio-project/

# Gradle files
.gradle/
build/

# Local configuration files
local.properties

# Android Studio and IntelliJ IDEA files
.idea/
*.iml
*.iws
*.ipr

# Android Studio cache
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/gradle.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/httpRequests/

# Keystore files
*.jks
*.keystore

# Log files
*.log

# OS-specific files
.ini
Thumbs.db

# Build directories
app/build/
*/build/

# Room schemas
*shared/schemas*

# Proguard configuration files
proguard-rules.pro

# Miscellaneous
*.apk
*.ap_
*.dex
*.class
*.salive

# Android NDK
ndkBuild/
local.properties

# personal files marked 'tmp_'
*tmp_*

# large files
*csv
*wav
*/ChoraleBricks/